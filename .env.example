# Frontend (Vite) — safe to expose, anon key is public by design
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ---------------------------------------------------------------
# Google sign-in — configured in Supabase Dashboard, NOT the frontend.
# Dashboard → Authentication → Providers → Google: paste Client ID + Secret.
# In Google Cloud Console → Credentials → your OAuth client, add redirect URI:
#   https://<project-ref>.supabase.co/auth/v1/callback
# For local `supabase start`, also add:
#   http://localhost:54321/auth/v1/callback
# ---------------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# ---------------------------------------------------------------
# Edge Function secrets — set these in Supabase Dashboard
# (Edge Functions → Secrets) or via `supabase secrets set`.
# NEVER put them in this file in real use, and never commit them.
# ---------------------------------------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
